datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String?
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  preferences  UserPreference?
  tasks        Task[]
  projects     Project[]
  categories   Category[]
  tags         Tag[]
  notifications Notification[]
  activityLogs TaskActivity[]

  @@map("users")
}

model UserPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme          String   @default("system")
  timezone       String   @default("UTC")
  defaultView    String   @default("list")
  defaultPriority String  @default("NONE")
  weekStartDay   Int      @default(1)
  emailReminders Boolean  @default(true)
  inAppReminders Boolean  @default(true)

  @@map("user_preferences")
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String?  @default("#3b82f6")
  icon        String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       Task[]

  @@index([userId, isArchived])
  @@map("projects")
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?  @default("#64748b")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks     Task[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Tag {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  createdAt DateTime  @default(now())

  tasks     TaskTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model Task {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  title          String
  description    String?
  status         String          @default("TODO") // TODO, IN_PROGRESS, COMPLETED, ARCHIVED
  priority       String          @default("NONE") // NONE, LOW, MEDIUM, HIGH, URGENT
  
  dueDate        DateTime?
  dueTime        String?
  completedAt    DateTime?
  order          Int             @default(0)

  subtasks       Subtask[]
  tags           TaskTag[]
  reminders      Reminder[]
  recurrenceRule RecurrenceRule?
  activities     TaskActivity[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, priority])
  @@index([userId, projectId])
  @@index([userId, categoryId])
  @@map("tasks")
}

model Subtask {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId, position])
  @@map("subtasks")
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
  @@map("task_tags")
}

model Reminder {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String?
  scheduledFor DateTime?
  remindAt    DateTime
  status      String    @default("PENDING") // PENDING, PROCESSING, SENT, FAILED, CANCELLED
  isSent      Boolean   @default(false)
  sentAt      DateTime?
  retryCount  Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([taskId])
  @@index([userId, status])
  @@index([remindAt, isSent])
  @@index([scheduledFor, status])
  @@map("reminders")
}

model RecurrenceRule {
  id           String    @id @default(cuid())
  taskId       String    @unique
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  frequency    String    // DAILY, WEEKDAYS, WEEKLY, MONTHLY, YEARLY, CUSTOM
  interval     Int       @default(1)
  daysOfWeek   String?   // Comma-separated: "0,1,2" (Sun=0)
  endDate      DateTime?
  maxOccurs    Int?
  currentCount Int       @default(0)
  createdAt    DateTime  @default(now())

  @@map("recurrence_rules")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // TASK_DUE, REMINDER, RECURRENCE_GENERATED, SYSTEM
  title     String
  message   String
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@map("task_activities")
}

